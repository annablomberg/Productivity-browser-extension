{
  "manifest_version": 3,
  "name": "Annas productivity helper",
  "description": "Track your time, disable reels and other fun stuff",
  "version": "0.0.1",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "YOUR_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.app.created"]
  },
  "icons": {
    "16": "heartbloom_icon.png",
    "32": "heartbloom_icon.png",
    "48": "heartbloom_icon.png",
    "128": "heartbloom_icon.png"
  },
  "action": {
    "default_title": "Open Productivity Timer",
    "default_icon": "heartbloom_icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-shorts-blocker.js"],
      "run_at": "document_start"
    }
  ]
}
